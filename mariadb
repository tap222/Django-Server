CREATE DATABASE sebayett;

--User data Table

CREATE TABLE user_data (
 user_id CHAR(36) unique not null primary key,
 email varchar(50) unique not null,
 discord_id BIGINT UNIQUE NOT NULL,
 discord_username VARCHAR(20) not null,
 global_name VARCHAR(30) NOT NULL,
 created_at timestamp not null default current_timestamp()
 );

--Archive for user data

CREATE TABLE user_data_archive (
 user_id char(36) not null,
 email varchar(50) not null,
 discord_id BIGINT NOT NULL,
 discord_username varchar(20) not null,
 global_name VARCHAR(30) NOT NULL,
 created_at TIMESTAMP NOT NULL,
 deleted_at timestamp not null default current_timestamp()
 );



--Archive TRIGGER

DELIMITER //

CREATE TRIGGER user_data_delete
BEFORE DELETE ON user_data
FOR EACH ROW
BEGIN
    INSERT INTO user_data_archive (
        user_id,
        email,
        discord_id,
        discord_username,
        global_name,
        created_at
    )
    VALUES (
        OLD.user_id,
        OLD.email,
        OLD.discord_id,
        OLD.discord_username,
        OLD.global_name,
        OLD.created_at
    );
END //

DELIMITER ;

